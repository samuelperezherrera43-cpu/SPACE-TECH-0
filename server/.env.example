# Puerto HTTP + WebSocket. Los proveedores (Render, Railway, Fly, etc.)
# inyectan su propio PORT; no lo fijes en producción.
PORT=2567

# Interfaz de escucha. 0.0.0.0 permite conexiones externas.
HOST=0.0.0.0

# development | production
NODE_ENV=development

# Orígenes permitidos (CORS + handshake WebSocket), separados por coma.
# En producción usa SIEMPRE el dominio real del juego.
# Ejemplo: https://space-tech.example.com,https://www.space-tech.example.com
# Vacío = todos (sólo desarrollo).
CORS_ORIGIN=

# URL pública anunciada en /health (informativo).
PUBLIC_URL=

# --- Sistema de invitaciones ---
# URL pública base para generar enlaces ${PUBLIC_URL}?invite=${token}.
# En producción debe ser la URL HTTPS del servidor (ej: https://mp.tu-dominio.com).
# Si está vacío, los tokens generan URLs relativas (?invite=) y la validación
# depende del cliente que pase el código manualmente.
PUBLIC_URL=

# TTL de la invitación en milisegundos (0 = sin caducidad).
# Recomendado: 3600000 (1 hora) para sesiones espontáneas.
INVITE_TTL_MS=3600000

# Número máximo de usos por invitación (0 = ilimitado).
# 1 uso es recomendado para seguridad máxima.
INVITE_MAX_USES=1

# Número máximo de intentos fallidos antes de bloquear la IP / token.
INVITE_MAX_ATTEMPTS=3

# Ventana de intentos en milisegundos (para contar los intentos fallidos).
# Después de este tiempo, el contador de intentos se reinicia.
INVITE_ATTEMPT_WINDOW_MS=60000

# Tiempo de bloqueo en milisegundos después de agotar los intentos.
# El usuario no podrá unirse mientras dure este bloqueo.
INVITE_BLOCK_MS=900000
